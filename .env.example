# Copy to .env at the repo root. Never commit .env.

# Claude API (needed by B's harness and by A when USE_REAL_INTELLIGENCE=1)
ANTHROPIC_API_KEY=

# Model IDs. Never hardcode model strings in code; read these.
MODEL_PARSE=claude-opus-5-5
MODEL_GRADE=claude-opus-5-5
MODEL_CHAT=claude-opus-5-5
MODEL_CLASSIFY=claude-haiku-5-5

# Behavior
DEMO_MODE=1                 # 1 = demo shortcuts (parse cache, L4 jump on confident correct answer)
USE_REAL_INTELLIGENCE=0     # 0 = shared fakes, 1 = @friction/intelligence (real Claude calls)
INTERCEPT_BUDGET_MS=4000

# Ports / URLs
API_PORT=8787               # real API (apps/api)
MOCK_PORT=8788              # scripts/mock-api.ts
DASH_PORT=5173              # apps/dashboard
API_URL=http://127.0.0.1:8787     # use 127.0.0.1, not localhost (Windows IPv6 quirk)
VITE_API_URL=http://127.0.0.1:8787
