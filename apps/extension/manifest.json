{
  "manifest_version": 3,
  "name": "Friction",
  "version": "0.1.0",
  "description": "Makes AI assistants teach instead of tell, based on your course skill tree.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Friction" },
  "content_scripts": [
    { "matches": ["https://claude.ai/*"], "js": ["main-world.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://claude.ai/*"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
